    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals needs access to your calendars to display, create, and edit events on the annual calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals에서 연간 캘린더의 일정을 표시하고 생성·편집하려면 캘린더 접근 권한이 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals benötigt Zugriff auf deine Kalender, um Ereignisse im Jahreskalender anzuzeigen, zu erstellen und zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals necesita acceder a tus calendarios para mostrar, crear y editar eventos en el calendario anual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals a besoin d’accéder à vos calendriers pour afficher, créer et modifier des événements dans le calendrier annuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間カレンダーで予定を表示・作成・編集するために、Petalsがカレンダーにアクセスする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Petals precisa acessar seus calendários para exibir, criar e editar eventos no calendário anual."
          }
        }
      }
    },
