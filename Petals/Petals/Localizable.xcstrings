    "iCloud sync could not start. Changes are saved on this Mac. Restart the app to retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync could not start. Changes are saved on this Mac. Restart the app to retry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화를 시작하지 못했습니다. 변경 내용은 이 Mac에 저장됩니다. 앱을 다시 실행하면 재시도합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung konnte nicht starten. Änderungen werden auf diesem Mac gespeichert. Starte die App erneut, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar la sincronización con iCloud. Los cambios se guardan en este Mac. Reinicia la app para volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud n’a pas pu démarrer. Les modifications sont enregistrées sur ce Mac. Relancez l’app pour réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期を開始できませんでした。変更はこのMacに保存されています。アプリを再起動してもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização com o iCloud. As alterações são salvas neste Mac. Reinicie o app para tentar novamente."
          }
        }
      }
    },
    "iCloud sync is temporarily unavailable. Changes remain saved on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sync is temporarily unavailable. Changes remain saved on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 iCloud 동기화를 사용할 수 없습니다. 변경 내용은 이 Mac에 보관됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist vorübergehend nicht verfügbar. Änderungen bleiben auf diesem Mac gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud no está disponible temporalmente. Los cambios siguen guardados en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est temporairement indisponible. Les modifications restent enregistrées sur ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud同期は一時的に利用できません。変更はこのMacに保存されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com o iCloud está temporariamente indisponível. As alterações continuam salvas neste Mac."
          }
        }
      }
    },
